{
  "name": "@kotoba-lang/opencloud",
  "version": "0.1.0",
  "private": true,
  "description": "Wire-compatible AWS, Azure, and GCP control-plane APIs for verification",
  "scripts": {
    "start": "kbb --backend sci --classpath src:resources -m opencloud.server",
