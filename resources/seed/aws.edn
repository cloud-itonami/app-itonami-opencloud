;; A deterministic AWS account.
;;
;; The contents are chosen, not arbitrary: this account contains a complete
;; privilege-escalation chain — an internet-facing instance whose role can
;; assume a second role that can read a bucket tagged sensitive — plus a role
;; any account may assume, a bucket shared with an outside account, and a
;; database with neither encryption nor backups. A posture client run against
;; this seed should find all of it; one that finds less has a gap.
;;
;; The credentials below are published on purpose and are not secret.

{:account-id "123456789012"
 :default-region "ap-northeast-1"
 :page-size 2

 ;; roles this credential is trusted to assume. A role that is not here is
 ;; refused, which is the case a client must not paper over with its own
 ;; credentials
 :assumable-roles ["arn:aws:iam::222222222222:role/SecurityAudit"
                   "arn:aws:iam::333333333333:role/MemberAccountAudit"]

 ;; reachable only from a session, not from the long-lived credential. This
 ;; is how an organisation is really read: assume the management account's
 ;; role, then assume a role in each member account **from that session**. A
 ;; client that signs the second AssumeRole with its base credentials is
 ;; refused, and the refusal says nothing about why
 :chained-roles ["arn:aws:iam::333333333333:role/MemberAccountAudit"]

 ;; what the other account holds. Reading it needs a session, and a client
 ;; that falls back to its own credentials finds the first account's estate
 ;; and files it under this account's name
 :assumed-accounts
 {"222222222222"
  {:account-id "222222222222"
   :instances [{:region "ap-northeast-1"
                :instance-id "i-0aud00000000000c3"
                :name "audit-target-1"
                :state "running"
                :image-id "ami-0abcdef1234567890"
                :instance-type "t3.micro"
                :private-ip "10.9.0.4"
                :subnet "subnet-0cccc"
                :vpc "vpc-0cccc"
                :http-tokens "required"
                :security-groups ["sg-0web000000000001"]
                :tags {"Name" "audit-target-1"}}]
   :buckets []
   :roles []
   :users []
   :keys []
   :db-instances []
   :security-groups []
   :volumes []}

  "333333333333"
  {:account-id "333333333333"
   :instances [{:region "ap-northeast-1"
                :instance-id "i-0mem00000000000d4"
                :name "member-target-1"
                :state "running"
                :image-id "ami-0abcdef1234567890"
                :instance-type "t3.small"
                :private-ip "10.11.0.7"
                :subnet "subnet-0dddd"
                :vpc "vpc-0dddd"
                :http-tokens "required"
                :security-groups ["sg-0web000000000001"]
                :tags {"Name" "member-target-1"}}]
   :buckets []
   :roles []
   :users []
   :keys []
   :db-instances []
   :security-groups []
   :volumes []}}

