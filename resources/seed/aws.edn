  {:group-id "sg-0edge00000000003"
   :group-name "edge"
   :vpc "vpc-0aaaa"
   :ingress [{:protocol "tcp" :from 443 :to 443 :cidrs-v6 ["::/0"]}]}]

 :buckets
 [{:name "payroll-archive"
   :created "2024-06-02T09:00:00.000Z"
   :region "ap-northeast-1"
   :public? false
   :public-access-block? true
   :encryption "aws:kms"
   :kms-key "arn:aws:kms:ap-northeast-1:123456789012:key/k-payroll"
   :tags {"sensitive" "true"}
   :policy {"Version" "2012-10-17"
            "Statement"
            [{"Sid" "PartnerRead"
              "Effect" "Allow"
              "Principal" {"AWS" "arn:aws:iam::999988887777:root"}
              "Action" ["s3:GetObject" "s3:ListBucket"]
              "Resource" "arn:aws:s3:::payroll-archive/*"}
             {"Sid" "DeployRoleRead"
              "Effect" "Allow"
              "Principal" {"AWS" "arn:aws:iam::123456789012:role/deploy-role"}
              "Action" "s3:GetObject"
              "Resource" "arn:aws:s3:::payroll-archive/*"}]}}
  {:name "reports-public"
   :created "2025-01-04T10:00:00.000Z"
   :region "ap-northeast-1"
   :public? true
   :public-access-block? false
   :encryption nil}
  {:name "build-artifacts"
   :created "2025-03-11T00:00:00.000Z"
   :region "ap-northeast-1"
   :public? false
   :public-access-block? true
   :encryption "AES256"}]

 :roles
 [{:name "web-role"
   :arn "arn:aws:iam::123456789012:role/web-role"
   :created "2024-02-01T00:00:00Z"
   :trust {"Version" "2012-10-17"
           "Statement" [{"Effect" "Allow"
                         "Principal" {"Service" "ec2.amazonaws.com"}
                         "Action" "sts:AssumeRole"}]}
   :attached-policies ["arn:aws:iam::123456789012:policy/web-read"]
   :inline-policies {"assume-deploy"
                     {"Version" "2012-10-17"
                      "Statement" [{"Effect" "Allow"
                                    "Action" "sts:AssumeRole"
                                    "Resource"
                                    "arn:aws:iam::123456789012:role/deploy-role"}]}}}
  {:name "deploy-role"
   :arn "arn:aws:iam::123456789012:role/deploy-role"
   :created "2024-02-01T00:00:00Z"
   :trust {"Version" "2012-10-17"
           "Statement" [{"Effect" "Allow"
                         "Principal"
                         {"AWS" "arn:aws:iam::123456789012:role/web-role"}
                         "Action" "sts:AssumeRole"}]}
   :attached-policies ["arn:aws:iam::123456789012:policy/deploy-write"]}
  {:name "partner-role"
   :arn "arn:aws:iam::123456789012:role/partner-role"
   :created "2025-05-01T00:00:00Z"
   :trust {"Version" "2012-10-17"
           "Statement" [{"Effect" "Allow"
                         "Principal" {"AWS" "arn:aws:iam::999988887777:root"}
                         "Action" "sts:AssumeRole"}]}}
  {:name "open-role"
   :arn "arn:aws:iam::123456789012:role/open-role"
   :created "2025-06-01T00:00:00Z"
   :trust {"Version" "2012-10-17"
           "Statement" [{"Effect" "Allow"
                         "Principal" "*"
                         "Action" "sts:AssumeRole"}]}}
  {:name "guarded-role"
   :arn "arn:aws:iam::123456789012:role/guarded-role"
   :created "2025-06-01T00:00:00Z"
   :trust {"Version" "2012-10-17"
           "Statement" [{"Effect" "Allow"
                         "Principal" {"AWS" "arn:aws:iam::999988887777:root"}
                         "Action" "sts:AssumeRole"
                         "Condition" {"StringEquals"
                                      {"sts:ExternalId" "tenant-42"}}}]}}]

 :users
 [{:name "opencloud"
   :arn "arn:aws:iam::123456789012:user/opencloud"
   :created "2024-01-05T00:00:00Z"
   :mfa? true
   :access-keys [{:id "AKIAOPENCLOUDEXAMPLE" :status "Active"
                  :created "2024-01-05T00:00:00Z"
                  :last-used "2026-07-20T00:00:00Z"}]}
  {:name "legacy-deploy"
   :arn "arn:aws:iam::123456789012:user/legacy-deploy"
   :created "2023-02-01T00:00:00Z"
   :mfa? false
   :attached-policies ["arn:aws:iam::123456789012:policy/legacy-admin"]
   :inline-policies {"legacy-bucket-write"
