                  :last-used nil}]}]

 :policies
 {"arn:aws:iam::123456789012:policy/web-read"
  {:name "web-read"
   :default-version "v3"
   :versions {"v3" {"Version" "2012-10-17"
                    "Statement" [{"Effect" "Allow"
                                  "Action" ["s3:GetObject" "s3:ListBucket"]
                                  "Resource" "arn:aws:s3:::build-artifacts/*"}]}}}
  "arn:aws:iam::123456789012:policy/deploy-write"
  {:name "deploy-write"
   :default-version "v1"
   :versions {"v1" {"Version" "2012-10-17"
                    "Statement" [{"Effect" "Allow"
                                  "Action" "s3:*"
                                  "Resource" "arn:aws:s3:::payroll-archive/*"}]}}}
  "arn:aws:iam::123456789012:policy/legacy-admin"
  {:name "legacy-admin"
   :default-version "v1"
   :versions {"v1" {"Version" "2012-10-17"
                    "Statement" [{"Effect" "Allow"
                                  "NotAction" "iam:*"
                                  "Resource" "*"}]}}}}

 ;; the key policy decides whether encryption at rest protects anything
 :keys
 [{:key-id "k-payroll"
   :arn "arn:aws:kms:ap-northeast-1:123456789012:key/k-payroll"
   :description "payroll archive"
   :manager "CUSTOMER"
   :enabled? true
   :policy {"Version" "2012-10-17"
            "Statement"
            [{"Sid" "Root" "Effect" "Allow"
              "Principal" {"AWS" "arn:aws:iam::123456789012:root"}
              "Action" "kms:*" "Resource" "*"}
             {"Sid" "PartnerDecrypt" "Effect" "Allow"
              "Principal" {"AWS" "arn:aws:iam::999988887777:root"}
              "Action" ["kms:Decrypt" "kms:DescribeKey"] "Resource" "*"}]}}
  {:key-id "k-builds"
   :arn "arn:aws:kms:ap-northeast-1:123456789012:key/k-builds"
   :description "build artifacts"
   :manager "CUSTOMER"
   :enabled? true
   :policy {"Version" "2012-10-17"
            "Statement" [{"Sid" "Root" "Effect" "Allow"
                          "Principal" {"AWS" "arn:aws:iam::123456789012:root"}
                          "Action" "kms:*" "Resource" "*"}]}}]

 :databases
 [{:identifier "payroll"
   :arn "arn:aws:rds:ap-northeast-1:123456789012:db:payroll"
   :engine "postgres"
   :engine-version "16.3"
   :public? false
   :encrypted? false
   :multi-az? true
   :backup-retention 0
   :deletion-protection? false
   :security-groups ["sg-0private00000002"]
   :tags {"sensitive" "true"}}]}
