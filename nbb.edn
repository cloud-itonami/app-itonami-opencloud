{:paths ["src" "resources" "test"]
 ;; nbb/kbb reads this file and does NOT read deps.edn: the coordinates that
 ;; live only in deps.edn are invisible to the engine (measured 2026-09-13 —
 ;; `nbb -m opencloud.server` answered "Could not find namespace:
 ;; kotoba.lang.text"). The git shas are copied byte-for-byte from deps.edn.
 :deps {io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/edn  {:git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}
        ;; test_host reads fixtures through the capability-injected fs seam
        ;; (same adapter pattern as cloud-itonami/cybersecurity, 2026-09-13).
        io.github.kotoba-lang/fs   {:local/root "../../kotoba-lang/fs"}}}
