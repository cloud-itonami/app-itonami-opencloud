(ns opencloud.portability-check
  "Run the deciding namespaces on both runtimes and compare.

    npm run test:portability

  The server runs on Node. This check drives the kbb route with Node's own
  child_process (kbb's engine has no clojure.java.shell). Anything that
  differs between the recorded-oracle side and the Node side is a defect
  the in-process test suite cannot see.")

(require '[kotoba.lang.edn :as edn]
         '[kotoba.lang.text :as str]
         '[opencloud.portability :as portability])

(def runner "(require '[opencloud.portability :as p]) (prn (p/results))")

(defn- node-results []
  ;; The temp script must live INSIDE this checkout: kbb resolves file paths
  ;; against the checkout's granted scope, and a /tmp script loses the
  ;; nbb.edn deps (measured — "Could not find namespace: kotoba.lang.text"
  ;; for a script in /tmp, works from target/).
  (let [fs     (js/require "fs")
        cp     (js/require "child_process")
        script (str "target/portability-" (js/Date.now) ".cljk")]
    (.writeFileSync fs script runner)
    (try
      (let [out (str (.execFileSync cp "kbb"
                                     #js ["--backend" "sci" "--classpath" "src:resources:test" script]
                                     #js {:encoding "utf8"}))]
        (edn/read-string out))
      (catch :default e
        (println "kbb failed:")
        (println (str/trim (str (.-stderr e) (.-stdout e) (.-message e))))
        (js/process.exit 1))
      (finally (.unlinkSync fs script)))))

(defn -main [& _]
  (let [node (node-results)
        oracle (portability/results)
        ids (sort (map str (distinct (concat (keys oracle) (keys node)))))
        differences (for [id ids
                          :let [k (keyword (subs id 1))
                                a (get oracle k ::absent)
                                b (get node k ::absent)]
                          :when (not= a b)]
                      [id a b])]
    (if (seq differences)
      (do (doseq [d differences] (prn d))
          (js/process.exit 1))
      (println "portability: both sides agree"))))

